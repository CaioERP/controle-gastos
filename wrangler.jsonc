// Configuração do Worker na Cloudflare. Passo a passo do deploy em docs/DEPLOY.md.
// Segredos (DATABASE_URL, SESSION_SECRET etc.) NÃO entram aqui: use `npx wrangler secret put <NOME>`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "controle-gastos",
  "main": "cloudflare-worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // O próprio Worker: o OpenNext usa para cache e o Cron Trigger usa para disparar cada job à parte.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "controle-gastos"
    }
  ],
  // A cada 15 min o Worker confere quais jobs venceram (a regra de intervalo continua em src/server/jobs).
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true
  }
  // Hyperdrive (opcional, deixa o banco mais rápido): crie com
  //   npx wrangler hyperdrive create controle-gastos-db --connection-string="<URL do Supabase>"
  // e descomente, colocando o id que o comando imprimir. Sem ele, o Worker usa o segredo DATABASE_URL.
  // ,"hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<id do hyperdrive>" }]
}
