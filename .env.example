# Banco: local usa PGlite. Produção: postgres://... (Supabase)
DATABASE_URL=pglite://.data/pglite
# Autenticação. Gere o hash e o SESSION_SECRET com: npx tsx scripts/hash-password.ts "sua-senha"
# AUTH_DISABLED=true só vale fora de produção (em produção o login é sempre exigido).
AUTH_DISABLED=true
APP_PASSWORD_HASH=
SESSION_SECRET=
# 2FA opcional (código do app autenticador). Gere com: npx tsx scripts/totp-setup.ts
APP_TOTP_SECRET=
# Pluggy (H-02)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Lista de itemIds separados por vírgula — usado só no teste F0-07
PLUGGY_ITEM_IDS=
# Segredo do webhook do Pluggy (vai na URL: /api/webhooks/pluggy?secret=...). Diferente do CRON_SECRET.
PLUGGY_WEBHOOK_SECRET=
# Jobs (A1-09). Chamadas externas a /api/jobs/* exigem "Authorization: Bearer <CRON_SECRET>"
SCHEDULER_ENABLED=true
CRON_SECRET=
# Cotações e cripto (A3-02)
BRAPI_TOKEN=
COINGECKO_API_KEY=
# PWA (B6-07). true para testar o PWA no npm run dev
NEXT_PUBLIC_ENABLE_SW=
# Notificações Push (A6-04). Gere as chaves com: npx tsx scripts/vapid-keys.ts
# VAPID_SUBJECT deve ser um mailto: (ex.: mailto:seu-email@dominio.com)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
